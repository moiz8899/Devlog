# Database
DATABASE_URL=postgresql://user:password@localhost:5432/devlog

# NextAuth
NEXTAUTH_URL=https://your-app-name.onrender.com
NEXTAUTH_SECRET=your-nextauth-secret-generate-with-openssl

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Production CORS (comma-separated URLs)
CORS_ORIGIN=https://your-app-name.onrender.com

# Optional: Custom Socket URL (if different from NEXTAUTH_URL)
# NEXT_PUBLIC_SOCKET_URL=https://your-app-name.onrender.com

