# Database
DATABASE_URL=postgresql://user:password@localhost:5432/devlog

# NextAuth
NEXTAUTH_URL=https://your-app-name.vercel.app
NEXTAUTH_SECRET=your-nextauth-secret-generate-with-openssl

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Cloudinary (for image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-cloudinary-upload-preset

# Optional: external realtime service URL
# NEXT_PUBLIC_SOCKET_URL=https://your-socket-service.example.com

# Optional: only needed if you run a separate socket server
# CORS_ORIGIN=https://your-app-name.vercel.app

